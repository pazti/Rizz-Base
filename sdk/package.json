{
  "name": "rizzbase",
  "version": "1.2.0",
  "description": "Local-first encrypted Projects, Lobbies and Yaps for Node.js",
  "type": "commonjs",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    }
  },
  "files": ["dist", "README.md", "LICENSE"],
  "engines": { "node": ">=20" },
  "license": "MIT",
  "publishConfig": { "access": "public" },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pazti/Rizz-Base.git",
    "directory": "sdk"
  },
  "homepage": "https://github.com/pazti/Rizz-Base/blob/main/docs/node-sdk.md",
  "bugs": { "url": "https://github.com/pazti/Rizz-Base/issues" },
  "keywords": ["database", "local-first", "encrypted", "rizzbase"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test test/*.test.cjs",
    "prepack": "npm run build",
    "prepublishOnly": "npm test"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.7.0"
  }
}
